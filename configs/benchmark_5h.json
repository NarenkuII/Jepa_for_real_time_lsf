      "commands": [
        [
          "${PYTHON}", "tools/train_continuous_ctc.py",
          "--checkpoint", "${ROOT}/runs/benchmark_5h/jepa_no_face/final.pt",
          "--data-root", "${ROOT}/data/alphabet_continuous_no_face",
          "--output-dir", "${ROOT}/runs/benchmark_5h/ctc_jepa_no_face",
