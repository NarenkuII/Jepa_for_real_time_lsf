      "commands": [
        [
          "${PYTHON}", "tools/train_mixed_direct_text.py",
          "--checkpoint", "${ROOT}/runs/benchmark_5h/jepa_no_face/final.pt",
          "--train-manifest", "${ROOT}/data/alphabet_continuous/manifests/continuous_train.jsonl",
          "--train-manifest", "${ROOT}/data/mediapi_rgb_canonical/manifests/mediapi_rgb_text_train.jsonl",
          "--val-manifest", "${ROOT}/data/alphabet_continuous/manifests/continuous_val.jsonl",
          "--val-manifest", "${ROOT}/data/mediapi_rgb_canonical/manifests/mediapi_rgb_text_val.jsonl",
          "--test-manifest", "${ROOT}/data/alphabet_continuous/manifests/continuous_test.jsonl",
          "--test-manifest", "${ROOT}/data/mediapi_rgb_canonical/manifests/mediapi_rgb_text_test.jsonl",
          "--output-dir", "${ROOT}/runs/benchmark_5h/direct_transformer_no_face",
          "--max-minutes", "32",
          "--drop-face"
