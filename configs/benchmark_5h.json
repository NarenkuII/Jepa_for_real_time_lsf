          "${PYTHON}", "${ROOT}/tools/evaluate_text_predictions.py",
          "--predictions", "${ROOT}/runs/benchmark_5h/ctc_jepa_no_face/evaluation/predictions.jsonl",
          "--output-dir", "${ROOT}/runs/benchmark_5h/ctc_jepa_no_face/evaluation"
        ]
      ]
    },
