          "${PYTHON}", "${ROOT}/tools/evaluate_text_predictions.py",
          "--predictions", "${ROOT}/runs/benchmark_5h/jepa_llm_face/evaluation/predictions.jsonl",
          "--output-dir", "${ROOT}/runs/benchmark_5h/jepa_llm_face/evaluation"
        ]
      ]
    },
    {
      "name": "jepa_llm_no_face",
      "priority": 71,
      "budget_minutes": 20,
      "cwd": "${LLM_ROOT}",
      "requires": [
        "${LLM_ROOT}/tools/train_jepa_llm.py",
        "${ROOT}/data/mediapi_rgb_canonical_no_face/manifests/mediapi_rgb_text_train.jsonl",
        "${ROOT}/runs/benchmark_5h/jepa_no_face/final.pt"
