          "--output-dir", "${ROOT}/runs/benchmark_5h/direct_transformer_face",
          "--max-minutes", "32"
        ],
        [
          "${PYTHON}", "tools/evaluate_mixed_direct_text.py",
          "--checkpoint", "${ROOT}/runs/benchmark_5h/direct_transformer_face/best.pt",
          "--manifest", "${ROOT}/data/mediapi_rgb_canonical/manifests/mediapi_rgb_text_test.jsonl",
          "--output-dir", "${ROOT}/runs/benchmark_5h/direct_transformer_face/evaluation"
        ],
