          "--checkpoint", "${ROOT}/runs/graph_jepa_context_fix/best.pt",
          "--train-manifest", "${ROOT}/data/alphabet_continuous/manifests/continuous_train.jsonl",
          "--train-manifest", "${ROOT}/data/mediapi_rgb_canonical/manifests/mediapi_rgb_text_train.jsonl",
