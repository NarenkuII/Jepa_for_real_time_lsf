          "--output-root", "${ROOT}/data/mediapi_rgb_canonical_no_face",
          "--drop-face"
        ]
      ]
    },
    {
      "name": "jepa_llm_face",
      "priority": 70,
      "budget_minutes": 20,
      "cwd": "${LLM_ROOT}",
      "requires": [
        "${LLM_ROOT}/tools/train_jepa_llm.py",
