          "--output-dir", "${ROOT}/runs/benchmark_5h/direct_transformer_no_face/evaluation",
          "--drop-face"
        ],
        [
          "${PYTHON}", "tools/evaluate_text_predictions.py",
          "--predictions", "${ROOT}/runs/benchmark_5h/direct_transformer_no_face/evaluation/predictions.jsonl",
          "--output-dir", "${ROOT}/runs/benchmark_5h/direct_transformer_no_face/evaluation"
        ]
