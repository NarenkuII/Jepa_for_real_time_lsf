      "budget_minutes": 35,
      "requires": [
        "${ROOT}/data/mediapi_rgb_canonical/manifests/mediapi_rgb_text_train.jsonl",
        "${ROOT}/data/mediapi_rgb_canonical/manifests/mediapi_rgb_text_val.jsonl",
        "${ROOT}/data/mediapi_rgb_canonical/manifests/mediapi_rgb_text_test.jsonl",
        "${ROOT}/runs/benchmark_5h/jepa_no_face/final.pt"
